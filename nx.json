{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "alpha",
  "affected": {
    "defaultBase": "alpha"
  },
  "defaultProject": "@myparcel-dev/vue-form-builder",
  "npmScope": "myparcel-vfb",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/libs/build-vite/*",
      "{workspaceRoot}/tsconfig.build.json",
      "{workspaceRoot}/yarn.lock",
      "{workspaceRoot}/package.json",
      "{projectRoot}/**/*"
    ],
    "prod": [
      "default",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/__mocks__/**",
      "!{projectRoot}/**/__snapshots__/**"
    ],
    "test": [
      "default",
      "{projectRoot}/dist/**/*",
      "{projectRoot}/**/*.spec.*",
      "{projectRoot}/**/__tests__/**",
      "{projectRoot}/**/__mocks__/**",
      "{projectRoot}/**/__snapshots__/**"
    ]
  },
  "targetDefaults": {
    "build:dev": {
      "cache": true,
      "inputs": ["prod"],
      "dependsOn": ["^build:dev"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/*.tsbuildinfo"]
    },
    "build": {
      "cache": true,
      "inputs": ["prod"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/*.tsbuildinfo"]
    },
    "test:run": {
      "cache": true,
      "inputs": ["test"]
    },
    "test:coverage": {
      "cache": true,
      "inputs": ["test"],
      "outputs": ["{workspaceRoot}/coverage"]
    },
    "typecheck": {
      "cache": true
    }
  },
  "parallel": 10
}
