{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "alpha",
  "affected": {
    "defaultBase": "alpha"
  },
  "defaultProject": "@myparcel-dev/vue-form-builder",
  "npmScope": "myparcel-vfb",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/libs/build-vite/*",
      "{workspaceRoot}/tsconfig.build.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/package.json",
      "{projectRoot}/**/*"
    ],
    "prod": [
      "default",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/__mocks__/**",
      "!{projectRoot}/**/__snapshots__/**"
    ],
    "test": [
      "default",
      "{projectRoot}/dist/**/*",
      "{projectRoot}/**/*.spec.*",
      "{projectRoot}/**/__tests__/**",
      "{projectRoot}/**/__mocks__/**",
      "{projectRoot}/**/__snapshots__/**"
    ]
  },
  "targetDefaults": {
    "build:dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build --mode development"
      },
      "inputs": ["prod"],
      "dependsOn": ["^build:dev"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/*.tsbuildinfo"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      },
      "inputs": ["prod"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/*.tsbuildinfo"]
    },
    "test:run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run"
      },
      "inputs": ["test"]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --coverage"
      },
      "inputs": ["test"],
      "outputs": ["{workspaceRoot}/coverage"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "rimraf dist coverage tsconfig.build.tsbuildinfo"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vue-tsc -p tsconfig.build.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest"
      }
    },
    "test:update": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run -u"
      }
    }
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "parallel": 10,
        "cacheableOperations": [
          "build",
          "build:dev",
          "test:coverage",
          "test:run",
          "typecheck"
        ]
      }
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false
    }
  },
  "release": {
    "projects": ["@myparcel-dev/vue-form-builder"],
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": true,
      "applyPreidToDependents": true
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": false,
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md",
        "createRelease": "github"
      }
    },
    "git": {
      "commitMessage": "chore: release [skip ci]",
      "push": true
    }
  }
}
